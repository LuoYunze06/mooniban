///|
pub fn country_spec(code : String) -> CountrySpec? {
  let needle = code.to_upper()
  for spec in registry() {
    if spec.code == needle {
      return Some(spec)
    }
  }
  None
}

///|
pub fn registered_countries() -> Array[String] {
  registry().map(fn(spec) { spec.code })
}
